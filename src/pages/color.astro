---
import { Image } from 'astro:assets';
import foto from '../assets/budapest.jpg';
import sello from '../assets/sello.png';
import bordado from '../assets/bordado.png';

const palabras = ['szia', 'Duna', 'villamos', 'Lánchíd', 'szerelem', 'kürtőskalács', 'Buda + Pest', 'pálinka', 'éjjel', 'Paula'];
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#f4e9d8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Szia, Paula · Budapest</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,400..900,100;1,9..144,400..900,100&family=Caveat:wght@500;700&family=DM+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<!-- Patrón del tejado Zsolnay (iglesia de Matías) -->
		<svg width="0" height="0" aria-hidden="true" style="position:absolute">
			<defs>
				<pattern id="tejas" width="28" height="32" patternUnits="userSpaceOnUse">
					<rect width="28" height="32" fill="#1f7a5c" />
					<polygon points="14,0 28,16 14,32 0,16" fill="#e8b931" stroke="#1b1b2f" stroke-width="1.2" />
					<polygon points="14,9 21,16 14,23 7,16" fill="#c4532d" />
					<polygon points="0,0 4,0 0,5" fill="#2348a0" />
					<polygon points="28,0 24,0 28,5" fill="#2348a0" />
				</pattern>
			</defs>
		</svg>

		<div class="tejado arriba" aria-hidden="true"><svg><rect width="100%" height="100%" fill="url(#tejas)" /></svg></div>

		<header>
			<p class="kicker">Budapest · Lánchíd · 2026</p>
			<h1><span class="szia">Szia,</span> Paula</h1>
			<p class="sub">una postal que hay que revelar</p>
		</header>

		<main class="escena">
			<div class="polaroid" id="polaroid" tabindex="0" role="img" aria-label="Polaroid de Paula en Budapest. Arrástrala para girarla; Enter para darle la vuelta.">
				<!-- Billete de tranvía asomando por detrás -->
				<div class="billete" aria-hidden="true">
					<span class="linea">2</span>
					<div>
						<b>BKV · VONALJEGY</b>
						<small>érvényes: egy életre</small>
					</div>
					<span class="taladro"></span>
				</div>

				<!-- Frente -->
				<div class="cara frente">
					<div class="foto">
						<Image src={foto} alt="Paula frente al Puente de las Cadenas iluminado, de noche, junto al Danubio" widths={[480, 760, 1100]} sizes="(max-width: 600px) 82vw, 380px" loading="eager" />
						<div class="velo"></div>
					</div>
					<p class="pie">Lánchíd, 23:47</p>
				</div>
				<div class="parche">
					<Image src={bordado} alt="" width={260} />
				</div>

				<!-- Dorso: entrada de diccionario -->
				<div class="cara dorso">
					<div class="dorso-top">
						<span class="marca">MAGYAR–SPANYOL<br />SZÓTÁR · p. 214</span>
						<Image src={sello} alt="Sello húngaro antiguo con el Puente de las Cadenas" class="sello" width={150} />
						<svg class="matasellos" viewBox="0 0 120 120" aria-hidden="true">
							<circle cx="60" cy="60" r="44" />
							<circle cx="60" cy="60" r="34" />
							<defs><path id="arco" d="M60 60 m-39 0 a39 39 0 1 1 78 0 a39 39 0 1 1 -78 0" /></defs>
							<text><textPath href="#arco" startOffset="2%">BUDAPEST · MAGYAR POSTA · BUDAPEST ·</textPath></text>
							<text x="60" y="64" text-anchor="middle" class="fecha">2026</text>
						</svg>
					</div>
					<div class="entrada">
						<p class="lema">szerelem <span class="fon">/ˈsɛrɛlɛm/</span></p>
						<p class="cat">sust. húngaro</p>
						<ol>
							<li>Lo que convierte una ciudad desconocida en un sitio al que volver.</li>
							<li>Cruzar el Danubio de noche sin ninguna prisa por llegar a la otra orilla.</li>
							<li>Que un puente con miles de bombillas acabe siendo solo el fondo de la foto.</li>
						</ol>
						<p class="ver"><i>ver también:</i> <span>Paula.</span></p>
					</div>
				</div>

				<div class="canto c-arriba"></div>
				<div class="canto c-abajo"></div>
				<div class="canto c-izq"></div>
				<div class="canto c-der"></div>
				<div class="brillo" aria-hidden="true"></div>
			</div>
		</main>

		<footer>
			<p class="pista" id="pista" aria-live="polite">agítala para revelarla ✦</p>
			<button id="girar" type="button"><span class="num">2</span> dar la vuelta</button>
		</footer>

		<div class="cinta" aria-hidden="true">
			<div class="pista-cinta">
				{[0, 1].map(() => palabras.map((p) => <span>{p} <em>✿</em></span>))}
			</div>
		</div>
		<div class="tejado abajo" aria-hidden="true"><svg><rect width="100%" height="100%" fill="url(#tejas)" /></svg></div>

		<script>
			const card = document.getElementById('polaroid')!;
			const btn = document.getElementById('girar')!;
			const pista = document.getElementById('pista')!;
			const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

			const REPOSO = -10; // ángulo de reposo (ligeramente girada)
			let rx = -4, ry = location.hash === '#dorso' ? 180 + REPOSO : REPOSO;
			let vx = 0, vy = 0, t = 0;
			let dragging = false, lastX = 0, lastY = 0;
			let target: number | null = null;
			let gyroX = 0, gyroY = 0, sgx = 0, sgy = 0; // inclinación del móvil (suavizada)
			let dev = location.hash === '#dorso' || reduce ? 1 : 0; // revelado de la foto 0→1
			let revelada = dev >= 1;
			if (revelada) pista.textContent = 'dale la vuelta ↻';

			const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));

			function revelar(cantidad: number) {
				if (revelada) return;
				dev = Math.min(1, dev + cantidad);
				if (dev >= 1) {
					revelada = true;
					navigator.vibrate?.(30);
					pista.textContent = '¡revelada! ahora dale la vuelta ↻';
				}
			}

			function render() {
				const X = rx + sgx, Y = ry + sgy;
				card.style.transform = `rotateX(${X}deg) rotateY(${Y}deg)`;
				card.style.setProperty('--dev', dev.toFixed(3));
				card.style.setProperty('--gx', `${50 + Math.sin((Y * Math.PI) / 180) * 70}%`);
				card.style.setProperty('--gy', `${45 - X * 2}%`);
				const n = ((Y % 360) + 360) % 360;
				card.classList.toggle('de-espaldas', n > 90 && n < 270);
			}

			function loop() {
				t += 0.016;
				revelar(0.0022); // se revela sola en ~7 s; agitarla lo acelera
				sgx += (gyroX - sgx) * 0.08;
				sgy += (gyroY - sgy) * 0.08;
				if (!dragging) {
					if (target !== null) {
						ry += (target - ry) * 0.1;
						if (Math.abs(target - ry) < 0.1) { ry = target; target = null; }
					} else {
						ry += vy; rx = clamp(rx + vx, -40, 40);
						vx *= 0.93; vy *= 0.93;
						// cuando pierde impulso, se asienta de frente o de espaldas
						if (Math.abs(vy) < 0.6) ry += (Math.round((ry - REPOSO) / 180) * 180 + REPOSO - ry) * 0.06;
						rx += (-4 - rx) * 0.04;
						if (!reduce) { ry += Math.sin(t * 0.9) * 0.05; rx += Math.cos(t * 0.7) * 0.03; }
					}
				}
				render();
				requestAnimationFrame(loop);
			}

			// Giroscopio y acelerómetro (en iOS hay que pedir permiso tras un toque)
			let pedido = false;
			async function activarSensores() {
				if (pedido) return; pedido = true;
				try {
					const DO = DeviceOrientationEvent as any;
					if (typeof DO?.requestPermission === 'function' && (await DO.requestPermission()) !== 'granted') return;
					const DM = DeviceMotionEvent as any;
					if (typeof DM?.requestPermission === 'function') await DM.requestPermission();
				} catch { return; }
				addEventListener('deviceorientation', (e) => {
					if (e.beta == null || e.gamma == null) return;
					gyroX = clamp((e.beta - 45) * -0.5, -18, 18);
					gyroY = clamp(e.gamma * 0.7, -25, 25);
				});
				addEventListener('devicemotion', (e) => {
					const a = e.acceleration;
					if (!a) return;
					const fuerza = Math.hypot(a.x ?? 0, a.y ?? 0, a.z ?? 0);
					if (fuerza > 8) revelar(fuerza * 0.0012);
				});
			}
			if (typeof (window as any).DeviceOrientationEvent?.requestPermission !== 'function') activarSensores();

			card.addEventListener('pointerdown', (e) => {
				activarSensores();
				dragging = true; target = null; vx = vy = 0;
				lastX = e.clientX; lastY = e.clientY;
				card.setPointerCapture(e.pointerId);
				card.classList.add('agarrada');
			});
			card.addEventListener('pointermove', (e) => {
				if (!dragging) return;
				const dx = e.clientX - lastX, dy = e.clientY - lastY;
				lastX = e.clientX; lastY = e.clientY;
				vy = dx * 0.5; vx = -dy * 0.3;
				ry += vy; rx = clamp(rx + vx, -40, 40);
				revelar(Math.hypot(dx, dy) * 0.0006); // sacudirla también la revela
			});
			const soltar = () => { dragging = false; card.classList.remove('agarrada'); };
			card.addEventListener('pointerup', soltar);
			card.addEventListener('pointercancel', soltar);

			const voltear = () => {
				activarSensores();
				vx = vy = 0;
				target = Math.round((ry - REPOSO) / 180) * 180 + 180 + REPOSO;
				navigator.vibrate?.(12);
			};
			btn.addEventListener('click', voltear);
			card.addEventListener('dblclick', voltear);
			card.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); voltear(); }
				if (e.key === 'ArrowLeft') ry -= 15;
				if (e.key === 'ArrowRight') ry += 15;
			});

			render();
			requestAnimationFrame(loop);
		</script>
	</body>
</html>

<style is:global>
	:root {
		--crema: #f4e9d8;
		--tinta: #1b1b2f;
		--cobalto: #2348a0;
		--mostaza: #e8b931;
		--esmeralda: #1f7a5c;
		--terracota: #c4532d;
		--rosa: #e86a8a;
		--tranvia: #ffd100;
		/* la polaroid cabe siempre en pantalla, a lo ancho y a lo alto */
		--w: min(80vw, 380px, 46svh);
		--h: calc(var(--w) * 1.21);
		--grosor: 5px;
	}
	* { box-sizing: border-box; }
	html, body { margin: 0; }
	body {
		min-height: 100svh;
		background:
			radial-gradient(70% 45% at 85% 30%, #e86a8a33, transparent 70%),
			radial-gradient(60% 40% at 10% 60%, #e8b93140, transparent 70%),
			radial-gradient(80% 50% at 50% 100%, #2348a026, transparent 70%),
			var(--crema);
		color: var(--tinta);
		font-family: 'Fraunces', Georgia, serif;
		display: flex; flex-direction: column;
		overflow-x: hidden;
		-webkit-tap-highlight-color: transparent;
	}
</style>

<style>
	/* ---------- Tejado Zsolnay ---------- */
	.tejado { flex: none; }
	.tejado svg { width: 100%; height: 100%; display: block; }
	.tejado.arriba {
		height: calc(46px + env(safe-area-inset-top));
		-webkit-mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 28px 100%;
		mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 28px 100%;
	}
	.tejado.abajo {
		height: calc(40px + env(safe-area-inset-bottom));
		-webkit-mask: conic-gradient(from 135deg at top, #0000, #000 1deg 89deg, #0000 90deg) 50% / 28px 100%;
		mask: conic-gradient(from 135deg at top, #0000, #000 1deg 89deg, #0000 90deg) 50% / 28px 100%;
	}

	/* ---------- Cabecera ---------- */
	header { text-align: center; padding: clamp(0.6rem, 2.5svh, 2rem) 16px 0; }
	.kicker {
		font-family: 'DM Mono', monospace; font-weight: 500; font-size: 0.66rem;
		letter-spacing: 0.22em; text-transform: uppercase; color: var(--esmeralda); margin: 0 0 0.3rem;
	}
	h1 {
		font-size: clamp(2.6rem, 12vw, 4.8rem); line-height: 0.9; margin: 0;
		font-weight: 900; letter-spacing: -0.035em; color: var(--cobalto);
		font-variation-settings: 'SOFT' 100, 'opsz' 144;
	}
	.szia { font-style: italic; color: var(--terracota); font-weight: 700; }
	.sub { font-family: 'Caveat', cursive; font-size: clamp(1.2rem, 5vw, 1.5rem); color: #1b1b2fa0; margin: 0.25rem 0 0; }

	/* ---------- Escena ---------- */
	.escena {
		flex: 1; display: grid; place-items: center; perspective: 1200px;
		padding: clamp(1rem, 3svh, 2.2rem) 16px 0.6rem;
	}
	.polaroid {
		position: relative; width: var(--w); height: var(--h);
		transform-style: preserve-3d; cursor: grab; touch-action: none; outline: none;
		will-change: transform; --dev: 0;
	}
	.polaroid.agarrada { cursor: grabbing; }
	.polaroid:focus-visible .frente, .polaroid:focus-visible .dorso { box-shadow: 0 0 0 3px var(--cobalto); }
	.cara { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; border-radius: 4px; }

	.frente {
		transform: translateZ(calc(var(--grosor) / 2));
		padding: 6% 6% 0; background: linear-gradient(165deg, #fffefa, #f3ede0);
		box-shadow: 0 20px 40px -18px #1b1b2f66, inset 0 0 0 1px #0000000d;
	}
	.foto { position: relative; aspect-ratio: 1; overflow: hidden; background: #2a2f36; }
	.foto :global(img) {
		width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; display: block;
		pointer-events: none; user-select: none; -webkit-user-drag: none;
		/* revelado de instantánea: de lechoso y frío a color pleno */
		filter:
			saturate(calc(0.1 + var(--dev) * 1))
			contrast(calc(0.55 + var(--dev) * 0.5))
			brightness(calc(1.5 - var(--dev) * 0.5))
			blur(calc((1 - var(--dev)) * 3px));
	}
	.velo {
		position: absolute; inset: 0; pointer-events: none;
		background: linear-gradient(160deg, #8fa3a8, #4c5a66);
		mix-blend-mode: color; opacity: calc(1 - var(--dev));
	}
	.pie {
		font-family: 'Caveat', cursive; font-weight: 700; color: var(--cobalto);
		font-size: calc(var(--w) * 0.08); text-align: center; margin: 0.45em 0 0; transform: rotate(-2deg);
	}

	/* Parche bordado pegado en la esquina */
	.parche {
		position: absolute; width: 30%; right: -7%; bottom: 6%; aspect-ratio: 1;
		border-radius: 50%; overflow: hidden; background: #fff;
		transform: translateZ(calc(var(--grosor) / 2 + 1.5px)) rotate(-12deg);
		backface-visibility: hidden; -webkit-backface-visibility: hidden;
		box-shadow: 0 0 0 3px #fff, 0 0 0 4.5px var(--terracota), 0 6px 14px -4px #1b1b2f66;
		outline: 1.5px dashed #c4532d99; outline-offset: -7px;
	}
	.parche :global(img) { width: 118%; height: 118%; margin: -9%; object-fit: cover; display: block; pointer-events: none; }

	/* Billete de tranvía */
	.billete {
		position: absolute; top: -9%; right: -14%; width: 62%;
		display: flex; align-items: center; gap: 0.5em; padding: 0.55em 0.7em;
		background: var(--tranvia); color: var(--tinta); border-radius: 3px;
		font-family: 'DM Mono', monospace; font-size: calc(var(--w) * 0.03);
		transform: translateZ(calc(var(--grosor) / -2 - 1px)) rotate(11deg);
		backface-visibility: hidden; -webkit-backface-visibility: hidden;
		box-shadow: 0 6px 16px -6px #1b1b2f55;
		-webkit-mask: radial-gradient(circle at 0 50%, #0000 5px, #000 5.5px) left / 51% 100% no-repeat,
			radial-gradient(circle at 100% 50%, #0000 5px, #000 5.5px) right / 51% 100% no-repeat;
		mask: radial-gradient(circle at 0 50%, #0000 5px, #000 5.5px) left / 51% 100% no-repeat,
			radial-gradient(circle at 100% 50%, #0000 5px, #000 5.5px) right / 51% 100% no-repeat;
	}
	.billete .linea {
		flex: none; width: 2.1em; height: 2.1em; border-radius: 50%; display: grid; place-items: center;
		background: var(--tinta); color: var(--tranvia); font-weight: 500; font-size: 1.3em;
	}
	.billete b { display: block; font-weight: 500; letter-spacing: 0.08em; }
	.billete small { display: block; font-size: 0.95em; opacity: 0.75; }
	.billete .taladro {
		position: absolute; right: 14%; top: 50%; width: 9px; height: 9px; border-radius: 2px;
		background: #1b1b2f22; box-shadow: 13px 0 #1b1b2f22, 6px 11px #1b1b2f22; transform: translateY(-50%);
	}

	/* ---------- Dorso ---------- */
	.dorso {
		transform: rotateY(180deg) translateZ(calc(var(--grosor) / 2));
		padding: 7% 7% 6%; display: flex; flex-direction: column;
		background:
			linear-gradient(90deg, transparent 13%, #c4532d40 13% calc(13% + 1px), transparent calc(13% + 1px)),
			repeating-linear-gradient(0deg, transparent 0 calc(var(--w) * 0.07), #2348a018 calc(var(--w) * 0.07) calc(var(--w) * 0.07 + 1px)),
			linear-gradient(200deg, #fffcf4, #f1e8d6);
		box-shadow: 0 20px 40px -18px #1b1b2f66;
	}
	.dorso-top { position: relative; display: flex; justify-content: space-between; align-items: flex-start; }
	.marca { font-family: 'DM Mono', monospace; font-size: calc(var(--w) * 0.024); letter-spacing: 0.16em; opacity: 0.5; line-height: 1.5; }
	.sello { width: 28%; height: auto; transform: rotate(5deg); mix-blend-mode: multiply; }
	.matasellos {
		position: absolute; right: 13%; top: 2%; width: 38%; overflow: visible;
		transform: rotate(-14deg); opacity: 0.7; mix-blend-mode: multiply;
	}
	.matasellos circle { fill: none; stroke: var(--terracota); stroke-width: 1.6; }
	.matasellos text { font-family: 'DM Mono', monospace; font-size: 8.5px; fill: var(--terracota); letter-spacing: 1px; }
	.matasellos .fecha { font-size: 14px; letter-spacing: 2px; }

	.entrada { margin-top: auto; font-size: calc(var(--w) * 0.043); line-height: 1.32; }
	.lema {
		margin: 0; font-weight: 900; font-size: 2.1em; letter-spacing: -0.03em; color: var(--cobalto); line-height: 1;
		font-variation-settings: 'SOFT' 100, 'opsz' 144;
	}
	.fon { font-family: 'DM Mono', monospace; font-weight: 400; font-size: 0.32em; letter-spacing: 0; color: #1b1b2f99; vertical-align: middle; }
	.cat { margin: 0.25em 0 0.5em; font-style: italic; color: var(--terracota); font-size: 0.9em; }
	ol { margin: 0; padding-left: 1.2em; }
	li { margin-bottom: 0.3em; }
	li::marker { font-weight: 700; color: var(--esmeralda); }
	.ver { margin: 0.45em 0 0; }
	.ver span {
		font-family: 'Caveat', cursive; font-weight: 700; font-size: 1.6em; color: var(--terracota);
		background: linear-gradient(transparent 62%, #e8b93188 62%); padding: 0 0.15em;
	}

	/* ---------- Canto y brillo ---------- */
	.canto { position: absolute; background: #e3d9c6; }
	.c-arriba, .c-abajo { left: 0; width: 100%; height: var(--grosor); }
	.c-izq, .c-der { top: 0; height: 100%; width: var(--grosor); }
	.c-arriba { top: 0; transform: translateY(-50%) rotateX(90deg); }
	.c-abajo { bottom: 0; transform: translateY(50%) rotateX(90deg); }
	.c-izq { left: 0; transform: translateX(-50%) rotateY(90deg); }
	.c-der { right: 0; transform: translateX(50%) rotateY(90deg); }
	.brillo {
		position: absolute; inset: 0; pointer-events: none; border-radius: 4px;
		transform: translateZ(calc(var(--grosor) / 2 + 0.6px));
		background:
			radial-gradient(55% 40% at var(--gx, 50%) var(--gy, 40%), #ffffffaa, transparent 70%),
			linear-gradient(115deg, transparent 30%, #e86a8a22 45%, #e8b93122 55%, transparent 70%);
		mix-blend-mode: soft-light; backface-visibility: hidden; -webkit-backface-visibility: hidden;
	}
	.de-espaldas .brillo { opacity: 0; }

	/* ---------- Pie y botón ---------- */
	footer { text-align: center; padding: 0.4rem 16px clamp(0.8rem, 2.5svh, 1.6rem); }
	.pista { font-family: 'Caveat', cursive; font-size: 1.3rem; color: var(--terracota); margin: 0 0 0.6rem; min-height: 1.4em; }
	button {
		display: inline-flex; align-items: center; gap: 0.6em;
		font-family: 'DM Mono', monospace; font-weight: 500; font-size: 0.85rem; letter-spacing: 0.06em;
		color: var(--tinta); background: var(--tranvia); border: 2px solid var(--tinta); border-radius: 999px;
		padding: 0.5em 1.2em 0.5em 0.5em; min-height: 48px; cursor: pointer;
		box-shadow: 4px 4px 0 var(--tinta); transition: transform 0.15s, box-shadow 0.15s;
	}
	button:active { transform: translate(3px, 3px); box-shadow: 1px 1px 0 var(--tinta); }
